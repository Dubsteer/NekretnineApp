@model NekretnineApp.Models.Category
@{
    ViewData["Title"] = "Izmijeni kategoriju";
}
<div class="row justify-content-center"><div class="col-lg-6"><div class="card shadow-sm border-0"><div class="card-body p-4"><h1 class="h3 mb-4">Izmijeni kategoriju</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div><button class="btn btn-primary">Sačuvaj izmjene</button><a asp-action="Index" class="btn btn-outline-secondary">Odustani</a></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
