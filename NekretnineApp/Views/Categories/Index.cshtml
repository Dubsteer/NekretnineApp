@model List<NekretnineApp.Models.Category>
@{
    ViewData["Title"] = "Kategorije";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div><h1 class="page-title mb-1">Kategorije nekretnina</h1><p class="text-muted mb-0">Upravljajte tipovima koji se koriste u oglasima.</p></div>
    <a asp-action="Create" class="btn btn-primary">Dodaj kategoriju</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Naziv</th><th>Status</th><th class="text-end">Radnje</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Name</td>
                    <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktivna" : "Neaktivna")</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Izmijeni</a>
                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-warning">@(item.IsActive ? "Deaktiviraj" : "Aktiviraj")</button></form>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Da li želite da obrišete kategoriju?');"><button class="btn btn-sm btn-outline-danger">Obriši</button></form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
