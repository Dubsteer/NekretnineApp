@model NekretnineApp.Models.Property
@{
    ViewData["Title"] = "Obriši oglas";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-4">
                <h1 class="h3 text-danger">Brisanje oglasa</h1>
                <p>Da li ste sigurni da želite da obrišete oglas, fotografije i zahtjeve za obilazak?</p>
                <div class="alert alert-light border"><strong>@Model.Title</strong><br />@Model.City, @Model.Address</div>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger">Obriši</button>
                    <a asp-action="MyProperties" class="btn btn-outline-secondary">Odustani</a>
                </form>
            </div>
        </div>
    </div>
</div>
