@model NekretnineApp.Models.ViewModels.PropertyFormViewModel
@{
    ViewData["Title"] = "Dodaj oglas";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5">
                <h1 class="h2 mb-1">Dodaj novu nekretninu</h1>
                <p class="text-muted mb-4">Unesite podatke i dodajte do osam fotografija.</p>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <partial name="_PropertyForm" model="Model" />
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Sačuvaj oglas</button>
                        <a asp-action="MyProperties" class="btn btn-outline-secondary">Odustani</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
