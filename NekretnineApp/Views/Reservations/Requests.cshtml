@model List<NekretnineApp.Models.ViewModels.ReservationItemViewModel>
@using NekretnineApp.Models
@{
    ViewData["Title"] = "Zahtjevi za obilazak";
    ReservationStatus? selectedStatus = ViewBag.SelectedStatus is ReservationStatus value ? value : null;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="page-title mb-1">Zahtjevi za obilazak</h1>
        <p class="text-muted mb-0">@(User.IsInRole(RoleNames.Admin) ? "Pregled svih zahtjeva u sistemu." : "Prihvatite ili odbijte zahtjeve za svoje nekretnine.")</p>
    </div>
    <form method="get" class="d-flex gap-2">
        <select name="status" class="form-select">
            <option value="">Svi statusi</option>
            @foreach (ReservationStatus status in Enum.GetValues(typeof(ReservationStatus)))
            {
                <option value="@status" selected="@(selectedStatus == status ? "selected" : null)">@status.DisplayName()</option>
            }
        </select>
        <button class="btn btn-outline-primary">Filtriraj</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state"><h3>Nema zahtjeva</h3><p class="text-muted mb-0">Za izabrani status nema zahtjeva za obilazak.</p></div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Nekretnina</th><th>Korisnik</th><th>Termin</th><th>Status</th><th>Napomena</th><th class="text-end">Radnje</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var reservation = item.Reservation;
                    var statusClass = reservation.Status switch
                    {
                        ReservationStatus.Approved => "bg-success",
                        ReservationStatus.Rejected => "bg-danger",
                        ReservationStatus.Cancelled => "bg-secondary",
                        _ => "bg-warning text-dark"
                    };
                    <tr>
                        <td><a asp-controller="Properties" asp-action="Details" asp-route-id="@reservation.PropertyId" class="fw-semibold text-decoration-none">@reservation.Property?.Title</a><div class="small text-muted">@reservation.Property?.City</div></td>
                        <td><strong>@item.UserName</strong><div class="small"><a href="mailto:@item.UserEmail">@item.UserEmail</a></div><div class="small text-muted">@item.UserPhone</div></td>
                        <td>@reservation.AppointmentDateTime.ToString("dd.MM.yyyy. HH:mm")</td>
                        <td><span class="badge @statusClass">@reservation.Status.DisplayName()</span></td>
                        <td class="small">@(string.IsNullOrWhiteSpace(reservation.Note) ? "—" : reservation.Note)</td>
                        <td class="text-end text-nowrap">
                            @if (reservation.Status == ReservationStatus.Pending)
                            {
                                <form asp-action="Approve" asp-route-id="@reservation.Id" method="post" class="d-inline"><button class="btn btn-sm btn-success">Prihvati</button></form>
                                <form asp-action="Reject" asp-route-id="@reservation.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Odbij</button></form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
