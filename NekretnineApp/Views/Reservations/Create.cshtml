@model NekretnineApp.Models.Reservation
@{
    ViewData["Title"] = "Zakaži obilazak";
    var property = ViewBag.Property as NekretnineApp.Models.Property;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5">
                <h1 class="h2 mb-1">Zakažite obilazak</h1>
                <p class="text-muted mb-4">Predložite datum i vrijeme, a oglašivač će prihvatiti ili odbiti zahtjev.</p>

                @if (property != null)
                {
                    <div class="appointment-property mb-4">
                        <strong>@property.Title</strong>
                        <span>@property.City, @property.Address</span>
                    </div>
                }

                <form asp-action="Create" method="post">
                    <input asp-for="PropertyId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="AppointmentDateTime" class="form-label"></label>
                        <input asp-for="AppointmentDateTime" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" step="900" class="form-control" />
                        <span asp-validation-for="AppointmentDateTime" class="text-danger"></span>
                        <div class="form-text">Termin izaberite u intervalima od 15 minuta.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label"></label>
                        <textarea asp-for="Note" rows="4" class="form-control" placeholder="Dodatna poruka oglašivaču (nije obavezno)"></textarea>
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Pošalji zahtjev</button>
                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary">Odustani</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
