@model NekretnineApp.Models.ViewModels.AdminDashboardViewModel
@using NekretnineApp.Models
@{
    ViewData["Title"] = "Administracija";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div><h1 class="page-title mb-1">Administratorska kontrolna tabla</h1><p class="text-muted mb-0">Pregled korisnika, oglasa, kategorija i zahtjeva za obilazak.</p></div>
    <div class="d-flex gap-2"><a asp-action="Users" class="btn btn-outline-primary">Korisnički nalozi</a><a asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary">Kategorije</a><a asp-action="Reports" class="btn btn-primary">Izvještaji</a></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6"><div class="stat-card"><span>Ukupno korisnika</span><strong>@Model.TotalUsers</strong><small>@Model.TotalAdvertisers oglašivača · @Model.TotalRegularUsers korisnika</small></div></div>
    <div class="col-xl-3 col-md-6"><div class="stat-card"><span>Nekretnine</span><strong>@Model.TotalProperties</strong><small>@Model.ActiveProperties aktivnih · @Model.InactiveProperties neaktivnih</small></div></div>
    <div class="col-xl-3 col-md-6"><div class="stat-card"><span>Kategorije</span><strong>@Model.TotalCategories</strong><small>Tipovi nekretnina</small></div></div>
    <div class="col-xl-3 col-md-6"><div class="stat-card"><span>Zahtjevi za obilazak</span><strong>@Model.TotalReservations</strong><small>@Model.PendingReservations na čekanju · @Model.ApprovedReservations prihvaćenih</small></div></div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Posljednji zahtjevi</h2><a asp-controller="Reservations" asp-action="Requests" class="btn btn-sm btn-outline-primary">Prikaži sve</a></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Nekretnina</th><th>Korisnik</th><th>Termin</th><th>Status</th></tr></thead>
            <tbody>
            @if (Model.RecentReservations.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">Nema zahtjeva.</td></tr>
            }
            else
            {
                @foreach (var item in Model.RecentReservations)
                {
                    <tr><td>@item.Reservation.Property?.Title</td><td>@item.UserName<div class="small text-muted">@item.UserEmail</div></td><td>@item.Reservation.AppointmentDateTime.ToString("dd.MM.yyyy. HH:mm")</td><td>@item.Reservation.Status.DisplayName()</td></tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
