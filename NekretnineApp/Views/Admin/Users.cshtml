@model List<NekretnineApp.Models.ViewModels.AdminUserViewModel>
@using NekretnineApp.Models
@{
    ViewData["Title"] = "Korisnički nalozi";
}

<div class="mb-4"><h1 class="page-title mb-1">Korisnički nalozi</h1><p class="text-muted mb-0">Pregledajte podatke, mijenjajte uloge i zaključavajte naloge.</p></div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Korisnik</th><th>Kontakt</th><th>Uloga</th><th>Status</th><th class="text-end">Radnje</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.FullName</strong><div class="small text-muted">@item.Email</div></td>
                    <td>@item.PhoneNumber</td>
                    <td><span class="badge bg-primary">@RoleNames.DisplayName(item.Role)</span></td>
                    <td><span class="badge @(item.IsLocked ? "bg-danger" : "bg-success")">@(item.IsLocked ? "Zaključan" : "Aktivan")</span></td>
                    <td class="text-end">
                        @if (item.Role != RoleNames.Admin)
                        {
                            <form asp-action="ChangeRole" method="post" class="d-inline-flex gap-1 align-items-center">
                                <input type="hidden" name="userId" value="@item.Id" />
                                <select name="role" class="form-select form-select-sm">
                                    <option value="@RoleNames.User" selected="@(item.Role == RoleNames.User ? "selected" : null)">Korisnik</option>
                                    <option value="@RoleNames.Advertiser" selected="@(item.Role == RoleNames.Advertiser ? "selected" : null)">Oglašivač</option>
                                </select>
                                <button class="btn btn-sm btn-outline-primary">Promijeni</button>
                            </form>
                            <form asp-action="ToggleLock" method="post" class="d-inline ms-1">
                                <input type="hidden" name="userId" value="@item.Id" />
                                <button class="btn btn-sm @(item.IsLocked ? "btn-outline-success" : "btn-outline-danger")">@(item.IsLocked ? "Otključaj" : "Zaključaj")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
